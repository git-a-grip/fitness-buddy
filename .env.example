# Backend
JWT_SECRET=changeme_jwt_secret_random_64chars
NODE_ENV=production
PORT=3000

# Frontend Build
VITE_API_BASE=/api

# Compose
APP_PORT=8088
DB_PORT=5438

# Web Push (VAPID) – einmalig generieren mit:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
